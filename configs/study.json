{
  "name": "right-to-dissent-600",
  "datasets": [
    {
      "id": "bbh",
      "tasks": "../data/bbh_300/tasks.jsonl",
      "answers": "../data/bbh_300/answers.jsonl"
    },
    {
      "id": "fresh",
      "tasks": "../data/study_600/fresh/tasks.jsonl",
      "answers": "../data/study_600/fresh/answers.jsonl"
    }
  ],
  "models": [
    {
      "id": "primary",
      "backend": "openrouter",
      "model": "$OPENROUTER_MODEL",
      "provider": "$OPENROUTER_PROVIDER"
    }
  ],
  "seeds": [
    2027,
    2028,
    2029
  ],
  "suite": "research",
  "selection": "disagreement",
  "limits": {
    "max_requests": 90000,
    "max_reported_cost_usd": 25.0
  },
  "inference": {
    "temperature": 0.7,
    "top_p": 1.0,
    "max_tokens": 8192,
    "max_tokens_ceiling": 32768,
    "send_seed": false,
    "dissent_threshold": 0.6,
    "max_attempts": 4,
    "retry_base_seconds": 1.0,
    "retry_max_seconds": 30.0,
    "request_timeout_seconds": 45.0
  },
  "statistics": {
    "bootstrap_samples": 2000,
    "seed": 2027,
    "comparisons": [
      [
        "protected_dissent",
        "standard_debate"
      ],
      [
        "protected_dissent_review",
        "standard_debate"
      ],
      [
        "protected_dissent",
        "explicit_dissent"
      ],
      [
        "protected_dissent",
        "extra_round_control"
      ],
      [
        "protected_dissent_review",
        "independent_review_control"
      ],
      [
        "protected_dissent",
        "reminder_revision"
      ],
      [
        "standard_debate",
        "independent_revision"
      ]
    ]
  }
}
